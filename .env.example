# ─── Groq LLM Configuration ───────────────────────────────────
# High-speed LLM for chat and intelligence (Llama 3 70B)
GROQ_API_KEY=your_groq_api_key_here

# ─── VoyageAI Embeddings ──────────────────────────────────────
# VoyageAI for high-accuracy text embeddings
VOYAGE_API_KEY=your_voyage_api_key_here

# ─── AssemblyAI Transcription ─────────────────────────────────
# Audio/Video transcription
ASSEMBLYAI_API_KEY=your_assemblyai_api_key_here

# ─── Supabase PostgreSQL Database ─────────────────────────────
# Set pool_recycle=1800 to prevent idle disconnects
DATABASE_URL=postgresql://user:password@aws-0-region.pooler.supabase.com:6543/postgres
DIRECT_URL=postgresql://user:password@aws-0-region.pooler.supabase.com:5432/postgres

# ─── Qdrant Vector Database ───────────────────────────────────
# Cloud Vector DB for similarity search
QDRANT_URL=https://your-cluster-url.cloud.qdrant.io:6333
QDRANT_API_KEY=your_qdrant_api_key_here

# ─── Upstash Redis (Celery Broker & Chat Cache) ───────────────
# Cloud Redis for Celery tasks, Webhooks, and Semantic Caching
# Must use rediss:// for secure TLS connections
REDIS_URL=rediss://default:password@endpoint.upstash.io:6379

# ─── Cloudinary (100GB Upload Offloading) ─────────────────────
# Frontend uploads directly to Cloudinary using HMAC signatures
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ─── Google OAuth Configuration ───────────────────────────────
# Google SSO and Profile Image fetching
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
# Frontend redirects here after login
FRONTEND_URL=http://localhost:3000

# ─── JWT Authentication ───────────────────────────────────────────
JWT_SECRET_KEY=your_secure_random_string_here_min_32_chars
JWT_ALGORITHM=HS256
JWT_EXPIRE_HOURS=24

# ─── Optional: Environment Mode ───────────────────────────────────
ENV=production
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://your-production-url.vercel.app

# ─── Gmail OTP Email Service (Forgot Password) ────────────────
EMAIL_ADDRESS=your_gmail_address@gmail.com
EMAIL_APP_PASSWORD=your_16_char_gmail_app_password