# ─── Groq LLM Configuration ───────────────────────────────────
# Get your free API key from https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here

# ─── MySQL Database Configuration ─────────────────────────────────
# Required: Create database "Meeting_analizer_user" before running
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=Meeting_analizer_user

# ─── JWT Authentication ───────────────────────────────────────────
# Generate a strong random string for JWT_SECRET_KEY
# Example: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET_KEY=your_secure_random_string_here_min_32_chars
JWT_ALGORITHM=HS256
JWT_EXPIRE_HOURS=24

# ─── Redis (Chat Memory Persistence) ─────────────────────────────
# Required: Redis server for chat history that survives restarts
# Default: redis://localhost:6379
REDIS_URL=redis://localhost:6379

# ─── Optional: Environment Mode ───────────────────────────────────
# Set to "production" to enable strict security checks
ENV=development

CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3001,https://meeting-intelligence-system-one.vercel.app